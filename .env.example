# headscaletest-poc — environment template
# Copy to `.env` and paste real values.
# The auth keys are generated inside the running headscale container, NOT in an
# admin console — see README step 4.

# Where sidecars find the headscale control plane.
# `host.docker.internal` is the host's IP from inside any container (Docker 20.10+
# on Linux). Sidecars reach headscale once at startup for registration, then never
# again — the WireGuard overlay handles all traffic after that.
HEADSCALE_URL=http://host.docker.internal:18080

# MagicDNS base domain. Each node becomes <hostname>.headscaletest.ts.net.
HEADSCALE_BASE_DOMAIN=headscaletest.ts.net